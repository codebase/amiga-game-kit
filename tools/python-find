#!/usr/bin/env bash
# Prints the newest Python 3.11+ on this machine: `python3` if it is one,
# else a versioned one (Homebrew sometimes leaves only python3.13 linked,
# and macOS's python3 is 3.9). The harness needs tomllib (3.11).
for p in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$p" >/dev/null 2>&1 &&
     "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    command -v "$p"
    exit 0
  fi
done
echo "agk needs Python 3.11 or newer; python3 here is $(python3 --version 2>&1 || echo missing)" >&2
exit 1
