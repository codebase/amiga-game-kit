#!/usr/bin/env bash
# Build a project into an Amiga executable and a bootable ADF, inside Docker.
#   tools/build [PROJECT_DIR]      (default: current directory)
# Output: PROJECT/build/<name> and PROJECT/build/<name>.adf, where <name> is
# the directory name (or `name` from agk.toml).
set -euo pipefail

KIT="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT="$(cd "${1:-.}" && pwd)"
NAME="$(basename "$PROJECT")"
if [ -f "$PROJECT/agk.toml" ]; then
  N="$(sed -n 's/^name *= *"\(.*\)"/\1/p' "$PROJECT/agk.toml" | head -1)"
  [ -n "$N" ] && NAME="$N"
fi
IMAGE="${AGK_TOOLCHAIN_IMAGE:-amigadev/crosstools:m68k-amigaos}"

if [ ! -d "$KIT/third_party/ACE" ]; then
  echo "ACE not found - run $KIT/tools/setup first" >&2
  exit 1
fi

mkdir -p "$PROJECT/build"
LOG="$PROJECT/build/build.log"
set +e
docker run --rm -u "$(id -u):$(id -g)" \
  -v "$PROJECT:/project" -v "$KIT:/kit:ro" -w /project "$IMAGE" sh -euc "
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/opt/m68k-amigaos/lib/m68k-amigaos.cmake \
    -DM68K_CPU=68000 -DM68K_FPU=soft -DM68K_CRT=nix13 \
    -DACE_DIR=/kit/third_party/ACE -DAGK_KIT=/kit >/dev/null
  cmake --build build -j
  m68k-amigaos-strip build/$NAME 2>/dev/null || true

  # OFS disk so Kickstart 1.3 can boot it; startup-sequence launches the game.
  printf '$NAME\n' > build/startup-sequence
  rm -f build/$NAME.adf
  xdftool build/$NAME.adf format AGK ofs + boot install \
    + write build/$NAME $NAME + makedir s \
    + write build/startup-sequence s/startup-sequence >/dev/null
" > "$LOG" 2>&1
RC=$?
set -e
if [ $RC -ne 0 ]; then
  # Show the compiler's diagnostics for this project first, then the log tail.
  grep -E "^/project/.*(error|warning)" "$LOG" | sed "s#^/project/##" || true
  echo "--- build failed (full log: $LOG) ---" >&2
  tail -25 "$LOG" >&2
  exit $RC
fi
# Warnings in the project's own code (ACE's are hidden; see build.log)
grep -E "^/project/[^:]*:[0-9]+:[0-9]+: warning" "$LOG" | sed "s#^/project/##" || true
echo "built $PROJECT/build/$NAME.adf ($(wc -c < "$PROJECT/build/$NAME" | tr -d ' ') byte executable)"
