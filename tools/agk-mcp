#!/usr/bin/env bash
# MCP server (stdio) for AI agents. Claude Code: claude mcp add amiga -- /path/to/tools/agk-mcp
ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
PY="$("$ROOT/tools/python-find")" || exit 1
PYTHONPATH="$ROOT/harness${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m agk.mcp "$@"
