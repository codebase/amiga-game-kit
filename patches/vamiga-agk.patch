+void
+SerialPort::agkHostWrite(u16 value)
+{
+    switch (agkHostState) {
+
+        case 0: // Waiting for the magic word
+            if (value == 0xA6E0) agkHostState = 1;
+            if (value == 0xA6E1) { agkTicks++; agkWorking = true; agnus.agkProfile.tick = true; retroShell.onAgkTick(); }
+            if (value == 0xA6E3) agkWorking = false;   // agkPerfEnd: the frame's work is done
+            if (value == 0xA6E2) agkHostState = 3;
+            break;
+
+        case 1: // Upper half of the string address
+        case 3: // Upper half of the state record's address
+            agkHostPtr = u32(value) << 16;
+            agkHostState++;
+            break;
+
+        case 2: // Lower half: copy the NUL-terminated string into the log
+        {
+            agkHostPtr |= value;
+            agkHostState = 0;
+            {   SYNCHRONIZED
+                for (isize i = 0; i < 4096; i++) {
+                    auto c = mem.spypeek8<Accessor::CPU>(u32(agkHostPtr + i));
+                    if (c == 0) break;
+                    agkLog += char(c);
+                }
+            }
+            break;
+        }
+
+        default: // Lower half: a state record, formatted here as "AGK k=v k=v"
+        {        // (ULONG count, then count x { key string address, LONG value })
+            agkHostPtr |= value;
+            agkHostState = 0;
+            {   SYNCHRONIZED
+                u32 count = mem.spypeek32<Accessor::CPU>(agkHostPtr);
+                std::string line = "AGK";
+                for (u32 i = 0; i < count && i < 64; i++) {
+                    u32 key = mem.spypeek32<Accessor::CPU>(agkHostPtr + 4 + 8 * i);
+                    i32 val = i32(mem.spypeek32<Accessor::CPU>(agkHostPtr + 8 + 8 * i));
+                    line += ' ';
+                    for (isize k = 0; k < 64; k++) {
+                        auto c = mem.spypeek8<Accessor::CPU>(u32(key + k));
+                        if (c == 0) break;
+                        line += char(c);
+                    }
+                    line += '=' + std::to_string(val);
+                }
+                // agkPerfReport's first key is the runtime's global g_szAgkPerfKey:
+                // its address places the game's code for agk profile
+                if (line.rfind("AGK perf frames=", 0) == 0) {
+                    agkPerfKeyAddr = mem.spypeek32<Accessor::CPU>(agkHostPtr + 4);
+                }
+                agkLog += line + '\n';
+            }
+            break;
+        }
+    }
+}
