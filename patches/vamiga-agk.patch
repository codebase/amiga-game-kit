+void
+RetroShell::awaitSerial(const string &pattern, isize frames)
+{
+    awaitPattern = pattern;
+    awaitFrames = frames;
+    scheduleWakeup(DMA_CYCLES(agnus.pos.cyclesPerFrame()));
+}
+
+void
+RetroShell::awaitTicks(isize ticks, isize timeoutFrames)
+{
+    awaitTickTarget = serialPort.agkTicks + ticks;
+    awaitFrames = timeoutFrames;
+    scheduleWakeup(DMA_CYCLES(agnus.pos.cyclesPerFrame()));
+}
+
+void
+RetroShell::onAgkTick()
+{
+    bool resume = false;
+
+    if (awaitTickTarget >= 0 && serialPort.agkTicks >= awaitTickTarget) {
+
+        awaitTickTarget = -1;
+        resume = true;
+    }
+    if (tickSync && !awaitPattern.empty()) {
+
+        auto pos = serialPort.agkLog.find(awaitPattern, awaitOffset);
+        if (pos != string::npos) {
+
+            awaitOffset = pos + awaitPattern.size();
+            awaitPattern.clear();
+            resume = true;
+        }
+    }
+    if (resume) {
+
+        // Run the script now, synchronously, at the start of the game frame
+        cancelWakeup();
+        exec();
+    }
+}
+
 void
 RetroShell::serviceEvent()
 {
+    if (awaitTickTarget >= 0) {
+
+        // Fallback timer while waiting for ticks: only detects a stuck game
+        if (--awaitFrames > 0) {
+
+            scheduleWakeup(DMA_CYCLES(agnus.pos.cyclesPerFrame()));
+            return;
+        }
+        *this << "waitticks: timeout - the game stopped marking frames (crashed, hung, or not calling agkPerfBegin)\n";
+        auto &log = serialPort.agkLog;
+        auto tail = log.size() > 1000 ? log.substr(log.size() - 1000) : log;
+        std::erase(tail, '\r');
+        *this << "waitserial: serial log tail (" << isize(log.size()) << " bytes total):\n";
+        *this << "<<<\n" << tail << "\n>>>\n";
+        awaitTickTarget = -1;
+        cancelWakeup();
+        commands.clear();
+        msgQueue.put(Msg::RSH_ERROR, objid);
+        return;
+    }
+
+    if (!awaitPattern.empty()) {
+
+        auto &log = serialPort.agkLog;
+        // In tick mode only ticks may match (determinism); frames just time out
+        auto pos = tickSync ? string::npos : log.find(awaitPattern, awaitOffset);
+
+        if (pos == string::npos) {
+
+            if (--awaitFrames > 0) {
+
+                // Not there yet: check again one frame later
+                scheduleWakeup(DMA_CYCLES(agnus.pos.cyclesPerFrame()));
+                return;
+            }
+
+            *this << "waitserial: timeout waiting for '" << awaitPattern << "'\n";
+
+            // Show what the Amiga did print; it's usually the best clue
+            auto tail = log.size() > 1000 ? log.substr(log.size() - 1000) : log;
+            std::erase(tail, '\r'); // the console treats CR as "clear line"
+            *this << "waitserial: serial log tail (" << isize(log.size()) << " bytes total):\n";
+            *this << "<<<\n" << tail << "\n>>>\n";
+            awaitPattern.clear();
+            cancelWakeup();
+            commands.clear();
+            msgQueue.put(Msg::RSH_ERROR, objid);
+            return;
+        }
+
+        // Later waits only match output that arrives after this match
+        awaitOffset = pos + awaitPattern.size();
+        awaitPattern.clear();
+    }
+
     emulator.put(Command(Cmd::RSH_EXECUTE));
     cancelWakeup();
 }
