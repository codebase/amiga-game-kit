diff --git a/Core/Components/Agnus/Agnus.cpp b/Core/Components/Agnus/Agnus.cpp
index 3c22e6c..6ed7cc1 100644
--- a/Core/Components/Agnus/Agnus.cpp
+++ b/Core/Components/Agnus/Agnus.cpp
@@ -867,6 +867,9 @@ Agnus::eolHandler()
     // Pass control to the DMA debugger
     dmaDebugger.eolHandler();
 
+    // AGK profiler: this line's bus usage and where the CPU is
+    if (agkProfile.active) agkProfileLine();
+
     // Move to the next line
     pos.eol();
 
@@ -909,6 +912,32 @@ Agnus::eolHandler()
     scheduleFirstDasEvent();
 }
 
+void
+Agnus::agkProfileLine()
+{
+    using P = AgkProfile;
+    u8 bus[P::KINDS] = { };
+    for (isize i = 0; i < HPOS_CNT; i++) {
+
+        auto o = busOwner[i];
+        int kind =
+        o == BusOwner::NONE ? P::FREE :
+        o == BusOwner::CPU ? P::CPU :
+        o == BusOwner::BLITTER ? P::BLITTER :
+        o == BusOwner::COPPER ? P::COPPER :
+        o == BusOwner::BLOCKED ? P::BLOCKED :
+        (o >= BusOwner::BPL1 && o <= BusOwner::BPL8) ? P::BITPLANES :
+        (o >= BusOwner::SPRITE0 && o <= BusOwner::SPRITE7) ? P::SPRITES : P::OTHER;
+        bus[kind]++;
+    }
+    auto &p = agkProfile;
+    u32 flags = (serialPort.agkWorking ? P::WORKING : 0) | (p.tick ? P::TICK : 0) | (pos.v == 0 ? P::NEW_FRAME : 0);
+    p.tick = false;
+    p.data.push_back((cpu.getPC0() & 0xFFFFFF) | flags);
+    p.data.push_back(u32(bus[0]) | u32(bus[1]) << 8 | u32(bus[2]) << 16 | u32(bus[3]) << 24);
+    p.data.push_back(u32(bus[4]) | u32(bus[5]) << 8 | u32(bus[6]) << 16 | u32(bus[7]) << 24);
+}
+
 void
 Agnus::eofHandler()
 {
diff --git a/Core/Components/Agnus/Agnus.h b/Core/Components/Agnus/Agnus.h
index 13d1452..8e1a2cb 100644
--- a/Core/Components/Agnus/Agnus.h
+++ b/Core/Components/Agnus/Agnus.h
@@ -204,6 +204,20 @@ public:
     // Recorded data bus for all cycles in the current rasterline
     u16 busData[HPOS_CNT] = { };
 
+    // AGK profiler: at the end of every line, where the CPU is and who used
+    // the bus. Outside the machine state (not serialized): recording never
+    // changes what the emulation does.
+    struct AgkProfile {
+        enum { FREE, CPU, BLITTER, BITPLANES, COPPER, SPRITES, OTHER, BLOCKED, KINDS };
+        static constexpr u32 WORKING = 1 << 24;   // between agkPerfBegin and agkPerfEnd
+        static constexpr u32 TICK = 1 << 25;      // a game frame started in this line
+        static constexpr u32 NEW_FRAME = 1 << 26; // the first line of a video frame
+        bool active = false;
+        bool tick = false;
+        std::vector<u32> data;          // per line: PC | flags, bus cycles by kind (8 x u8 in 2 u32)
+    } agkProfile;
+    void agkProfileLine();
+
     // Remembers the last write to SPRxCTL (EXPERIMENTAL)
     u8 lastCtlWrite[8] = { };
 
