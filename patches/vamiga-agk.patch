+void
+SerialPort::agkHostWrite(u16 value)
+{
+    switch (agkHostState) {
+
+        case 0: // Waiting for the magic word
+            if (value == 0xA6E0) agkHostState = 1;
+            if (value == 0xA6E1) { agkTicks++; retroShell.onAgkTick(); }
+            break;
+
+        case 1: // Upper half of the string address
+            agkHostPtr = u32(value) << 16;
+            agkHostState = 2;
+            break;
+
+        default: // Lower half: copy the NUL-terminated string into the log
+        {
+            agkHostPtr |= value;
+            agkHostState = 0;
+            {   SYNCHRONIZED
+                for (isize i = 0; i < 4096; i++) {
+                    auto c = mem.spypeek8<Accessor::CPU>(u32(agkHostPtr + i));
+                    if (c == 0) break;
+                    agkLog += char(c);
+                }
+            }
+            break;
+        }
+    }
+}
