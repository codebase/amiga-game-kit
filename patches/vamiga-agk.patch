+void
+Agnus::agkProfileLine()
+{
+    using P = AgkProfile;
+    u8 bus[P::KINDS] = { };
+    for (isize i = 0; i < HPOS_CNT; i++) {
+
+        auto o = busOwner[i];
+        int kind =
+        o == BusOwner::NONE ? P::FREE :
+        o == BusOwner::CPU ? P::CPU :
+        o == BusOwner::BLITTER ? P::BLITTER :
+        o == BusOwner::COPPER ? P::COPPER :
+        o == BusOwner::BLOCKED ? P::BLOCKED :
+        (o >= BusOwner::BPL1 && o <= BusOwner::BPL8) ? P::BITPLANES :
+        (o >= BusOwner::SPRITE0 && o <= BusOwner::SPRITE7) ? P::SPRITES : P::OTHER;
+        bus[kind]++;
+    }
+    auto &p = agkProfile;
+    u32 flags = (serialPort.agkWorking ? P::WORKING : 0) | (p.tick ? P::TICK : 0) | (pos.v == 0 ? P::NEW_FRAME : 0);
+    p.tick = false;
+    p.data.push_back((cpu.getPC0() & 0xFFFFFF) | flags);
+    p.data.push_back(u32(bus[0]) | u32(bus[1]) << 8 | u32(bus[2]) << 16 | u32(bus[3]) << 24);
+    p.data.push_back(u32(bus[4]) | u32(bus[5]) << 8 | u32(bus[6]) << 16 | u32(bus[7]) << 24);
+}
