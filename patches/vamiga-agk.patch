+    std::vector<std::pair<string, isize>> agkMarks;  // name, sample index
+    static constexpr double agkCaptureRate = 44100.0;
+    void agkStart() {
+        agkCapture.clear();
+        agkMarks.clear();
+        fraction = 0.0;     // not in snapshots: reset so recordings are identical
+        agkCapturing = true;
+    }
+    void agkRecord(double l, double r) {
+        if (agkCapturing) agkCapture.push_back(i16(std::clamp((l + r) * 0.5, -1.0, 1.0) * 32767.0));
