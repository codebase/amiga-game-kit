# Side hit: cross pit 1 and run straight into enemy 1. The hero dies and
# respawns at the start (like a pit): deaths=1, no stomp.
wait-serial "AGK t0"         # same game frame on every profile (see main.c)
press right 154
press right+up 1
hold right
wait-serial "AGK hit id=1"
release
wait 3
screenshot respawned
expect-serial "AGK hit id=1\nAGK frame=\d+ x=32 y=192 cam=0 .* deaths=1 stomps=0"
expect-no-serial "AGK stomp"
# the hero is back at the start (screen x 32)
expect-color respawned 40 190 0x723 near 2   # hero scarf
