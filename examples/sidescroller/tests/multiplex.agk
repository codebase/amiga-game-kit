# Three enemies on screen at once, at three heights, all on ONE attached
# sprite pair (channels 4+5): enemy 0 on the slab (y 96), enemy 2 on the low
# slab (y 144), enemy 1 on the ground (y 192). The hero waits at the edge of
# pit 1 (enemy 1 can't cross it).
wait-serial "AGK t0"         # same game frame on every profile (see main.c)
press right 154
wait 39
screenshot three
expect-serial "x=340 y=192 cam=188"
expect-serial "spr=3 skip=0"                # 3 enemies in the chain
expect-no-serial "skip=[1-9]"
# one enemy per height, all visible in the same frame
expect-color three 94 101 0xD43 near 2    # enemy 0, slab, y 96
expect-color three 302 149 0xD43 near 2   # enemy 2, low slab, y 144
expect-color three 278 197 0xD43 near 2   # enemy 1, ground, y 192
expect-no-serial "deaths=[1-9]"
