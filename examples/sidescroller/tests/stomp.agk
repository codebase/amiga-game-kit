# Stomp: cross pit 1, hop towards enemy 1 on the ground and drop onto it.
# The enemy shows its squashed frame for 0.5 s, then disappears; the hero
# bounces up (vy = -72, a ~25 px hop) and nobody dies.
wait-serial "AGK t0"         # same game frame on every profile (see main.c)
press right 154
press right+up 1
press right 36
press right+up 1
press right 15
wait-serial "AGK stomp id=1"
wait 2
screenshot squashed
wait 30
screenshot gone
expect-serial "AGK stomp id=1 x=\d+ y=192"
# the stomp frame: falling onto it, then bounced (vy -72, off the ground)
expect-serial "stomps=0\n(AGK stomp id=1 .*\n)AGK frame=\d+ x=446 y=182 .* ground=0 vy=-72 .* deaths=0 stomps=1"
expect-no-serial "deaths=[1-9]"
expect-no-serial "AGK hit"
# squashed frame (only it has red in rows 11-12: y 203-204), under the hero
# enemy at x 443, camera 294: screen x 149
expect-color squashed 151 203 0xD43
expect-color squashed 155 204 0xD43
# 0.5 s later it's gone: the hills show where it lay
expect-color gone 151 204 0x273
expect-color gone 155 204 0x153
