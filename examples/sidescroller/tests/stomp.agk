# Stomp: hop towards enemy 0 on the ground and drop onto it. The enemy shows
# its squashed frame for 0.5 s, then disappears; the hero bounces up
# (vy = -72, a ~25 px hop) and nobody dies.
wait-serial "AGK t0"         # same game frame on every profile (see main.c)
press right 50
press right+up 1
press right 30
wait-serial "AGK stomp id=0"
wait 2
screenshot squashed
wait 30
screenshot gone
expect-serial "AGK stomp id=0 x=\d+ y=192"
# the stomp frame: falling onto it, then bounced (vy -72, off the ground)
expect-serial "stomps=0\nAGK sfx stomp\n(AGK stomp id=0 .*\n)AGK frame=\d+ x=194 y=183 .* ground=0 vy=-72 .* deaths=0 stomps=1"
expect-no-serial "deaths=[1-9]"
expect-no-serial "AGK hit"
expect-serial "AGK sfx stomp"
# squashed frame (only it has red in rows 11-12: y 207-208, drawn 4 px into
# the grass top face), under the hero; enemy at x 189, camera 42: screen x 147
expect-color squashed 153 207 0xD43
expect-color squashed 155 208 0xD43
# 0.5 s later it's gone: the hills (between the grass blades) and the grass
# top face show where it lay
expect-color gone 153 207 0x9C4
expect-color gone 155 208 0x9C4
expect-color gone 149 209 0x8D3
