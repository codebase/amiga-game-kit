# The hero (art/hero.txt) picks its frame from the game state: idle/breathe
# (0/1), an 8-frame walk (2-9), jump (10), fall (11), and mirrored copies
# (+12) when facing left.
wait-serial "AGK t0"         # same game frame on every profile (see main.c)
wait 40
screenshot idle
expect-serial "anim=1"                 # breathing while standing still
hold right
wait-serial "anim=9"
screenshot walking
expect-serial "anim=2"
expect-serial "anim=5"
expect-serial "anim=8"
release
press up 3
wait-serial "anim=10"
screenshot jumping
wait-serial "anim=11"
screenshot falling
wait 40
hold left
wait-serial "left=1"
wait 2
screenshot facing_left
release
wait 2
expect-serial "left=1"
