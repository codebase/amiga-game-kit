# Enemy 0 patrols the first stretch of ground (x 170..264, feet on y 207),
# drawn with the multiplexed sprite pair (channels 4+5, attached, 15 colours).
# It walks left at 0.5 px/frame, turns at x 170 and comes back facing right.
# The hero stands still at the start, out of its reach.
wait-serial "AGK t0"         # same game frame on every profile (see main.c)
wait 10
screenshot walk1
wait 40
screenshot walk2
wait 200
screenshot turned
expect-serial "spr=1 skip=0"
expect-no-serial "deaths=[1-9]"
# red cap (0xD43), sprite x ~234, facing left, drawn 4 px into the grass top face
expect-color walk1 238 201 0xD43
# 20 px further left 40 frames later: the old spot shows the hills again
expect-color walk2 218 201 0xD43
expect-color walk2 238 201 0x273
# turned at x 170 and walked back: about the same x as walk1, but the mirrored
# (right-facing) frame. Cap row y=202: the white spot moved from x 234-235
# (facing left) to x 233-234 (facing right).
expect-color walk1 235 202 0xFFF
expect-color walk1 233 202 0xD43
expect-color turned 235 202 0xD43
expect-color turned 233 202 0xFFF
