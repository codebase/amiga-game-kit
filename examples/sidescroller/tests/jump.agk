# Jump through the one-way stone slab (row 10, x 128..191) and land on it,
# then walk off its end and fall back to the ground.
wait-serial "AGK t0"         # same game frame on every profile (see main.c)
press right 56
expect-serial "x=144 y=192 cam=0"
press up 1
wait-serial "x=144 y=150 cam"
screenshot jumping
expect-serial "x=144 y=150 cam=0 mtn=0 hills=0 ground=0"
# the sprite is in the air (display is one frame behind: y=153), in front of the slab
expect-color jumping 152 156 0x723 near 3 # hero scarf
expect-color jumping 151 192 0x8BC
wait 60
screenshot landed
expect-serial "x=144 y=144 cam=0 mtn=0 hills=0 ground=1 vy=0 walk=0 anim=[01] left=0 jumps=1"
expect-color landed 152 146 0x723 near 2   # hero scarf
# walk off the right end of the slab: falls, lands on the ground
press right 30
wait 12                     # landed; enemy 0 is walking towards him
screenshot fell
expect-serial "x=204 y=192 cam=52 mtn=13 hills=26 ground=1"
expect-color fell 100 160 0xCCB
expect-color fell 160 194 0x723 near 2       # hero scarf
